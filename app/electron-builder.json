{
	"appId": "com.gldtk.app",
	"productName": "GLDtk",
	"copyright": "GLDtk is built on LDtk by Sebastien Benard (deepnight), MIT licence",
	"artifactName": "${productName}-${version}-${arch}.${ext}",

	"directories": {
		"buildResources": "buildAssets",
		"output": "redist"
	},

	"extraFiles": [
		"extraFiles/embedAtlas",
		"extraFiles/changelogImg",
		"extraFiles/samples",
		{
			"from": "extraFiles/README.txt",
			"to": "README.txt"
		}
	],

	"files": [
		"assets",
		"package.json"
	],

	"fileAssociations": [
		{
			"ext": "ldtk",
			"name": "LDTK Project File",
			"mimeType": "application/json",
			"icon": "project.ico",
			"role": "Editor"
		},
		{
			"ext": "ldtkl",
			"name": "LDTK Level File",
			"mimeType": "application/json",
			"icon": "level.ico",
			"role": "Editor"
		}
	],

	"nsis": {
		"oneClick": true,
		"shortcutName": "GLDtk"
	},

	"win": {
		"target": "nsis",
		"publish": ["github"]
	},

	"extraResources": [
		{
			"from": "../../packaging/dist/gldtk-server",
			"to": "gldtk-server"
		}
	],

	"mac": {
		"category": "public.app-category.developer-tools",
		"identity": null,
		"target": [ "dmg" ]
	}
}